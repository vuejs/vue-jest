{
  "name": "vue3-typescript-with-compiler-options",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "jest --no-cache ./src/test.ts"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vue": "^3.2.22"
  },
  "devDependencies": {
    "@types/jest": "16.0.10",
    "@vue/vue3-jest": "^30.0.0",
    "jest": "30.x",
    "jest-environment-jsdom": "30.x",
    "ts-jest": "^29.4.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "js",
      "ts",
      "json",
      "vue"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.vue$": "@vue/vue3-jest"
    },
    "globals": {
      "vue-jest": {
        "compilerOptions": {
          "propsDestructureTransform": true
        }
      }
    }
  }
}
